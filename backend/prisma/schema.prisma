generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  email        String        @unique
  password     String?       // nullable: criado pelo webhook antes do assessor definir senha
  role         String        @default("pending") // pending | user | admin
  preferences  String[]
  clients      Clients[]
  subscription Subscription?
  setupTokens  PasswordSetupToken[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Subscription {
  id                          Int      @id @default(autoincrement())
  userId                      Int      @unique
  user                        User     @relation(fields: [userId], references: [id])
  abacatepaySubscriptionId    String?  // ID da assinatura na AbacatePay
  abacatepayCustomerId        String?  // ID do customer na AbacatePay
  status                      String   @default("ACTIVE") // ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  currentPeriodEnd            DateTime?
  plan                        String   @default("monthly")
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt
}

model PasswordSetupToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProcessedWebhookEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @unique
  eventType   String
  payload     Json
  receivedAt  DateTime @default(now())
}

model User_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  generatedAt  DateTime @default(now())
}

model Client_cache {
  id           Int      @id @default(autoincrement())
  owner_id     Int      @unique
  content_json Json
  summary      String?
  generatedAt  DateTime @default(now())
}

model Clients {
  id          Int      @id @default(autoincrement())
  name        String
  number      String
  user_id     Int
  preferences String[] @default([])
  user        User     @relation(fields: [user_id], references: [id])
}
